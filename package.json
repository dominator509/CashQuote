{
  "name": "cashquote",
  "version": "1.0.0",
  "description": "QuoteCash Invoice Copilot production MVP",
  "private": true,
  "scripts": {
    "build": "npm run prisma:generate && npm run build:shared && npm run build:db && npm run build:server && npm run build:client",
    "build:client": "npm run build --workspace client",
    "build:db": "npm run build --workspace db",
    "build:server": "npm run build --workspace server",
    "build:shared": "npm run build --workspace shared",
    "lint": "eslint .",
    "prisma:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "start:prod": "npm run prisma:migrate && node server/dist/index.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "typecheck": "npm run typecheck --workspace shared && npm run typecheck --workspace db && npm run typecheck --workspace server && npm run typecheck --workspace client"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dominator509/CashQuote.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "uuid": "^14.0.0"
  },
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "db": "*",
    "dotenv": "^17.4.2"
  }
}
