{
  "name": "cashquote",
  "version": "1.0.0",
  "description": "QuoteCash Invoice Copilot production MVP",
  "private": true,
  "scripts": {
    "build": "npm run prisma:generate && npm run build:shared && npm run build:db && npm run build:server && npm run build:client",
    "build:client": "npm run build --workspace client",
    "build:db": "npm run build --workspace db",
    "build:server": "npm run build --workspace server",
    "build:shared": "npm run build --workspace shared",
    "lint": "eslint .",
    "prisma:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "smoke:prod": "npm run build && node scripts/smoke-prod.mjs",
    "start:prod": "node scripts/start-prod.mjs",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:integration": "jest --runInBand tests/integration",
    "test:security": "jest --runInBand tests/security",
    "test:unit": "jest --runInBand tests/unit",
    "typecheck": "npm run typecheck --workspace shared && npm run typecheck --workspace db && npm run typecheck --workspace server && npm run typecheck --workspace client",
    "validate:prod": "npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:integration && npm run test:security && npm audit --audit-level=high && npm run smoke:prod && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dominator509/CashQuote.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "uuid": "^14.0.0",
    "wait-on": "^9.0.10"
  },
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "cors": "^2.8.6",
    "db": "*",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "nodemailer": "^9.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  }
}
