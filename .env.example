NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashquote
JWT_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Local/test-only shared code; production uses per-email codes below.
PILOT_ACCESS_CODE=replace-with-private-pilot-code
# JSON object of per-email private pilot codes; required when NODE_ENV=production.
PILOT_EMAIL_ACCESS_CODES=
PILOT_EMAIL_ALLOWLIST=
ALLOW_DEMO_LOGIN=false
OPENAI_API_KEY=
# Production requires smtps://; local/test may use smtp:// against a trusted capture server.
SMTP_URL=
SMTP_FROM=
ALLOW_MOCK_EMAIL=false
LOG_LEVEL=info
TRUST_PROXY=false
